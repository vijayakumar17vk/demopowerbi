model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Customer","Location","Orders","Product","Sales"]

annotation PBI_ProTooling = ["DevMode"]

ref table Customer
ref table Location
ref table Orders
ref table Product
ref table Sales

ref cultureInfo en-US

